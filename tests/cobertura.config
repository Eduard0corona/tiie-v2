<?xml version="1.0" encoding="utf-8"?>
<!-- Cobertura de la puerta de docs/12-pruebas.md#puertas-del-ci: solo el código de producción. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*Tiie\.Dominio\.dll$</ModulePath>
        <ModulePath>.*Tiie\.Aplicacion\.dll$</ModulePath>
        <ModulePath>.*Tiie\.Infraestructura\.dll$</ModulePath>
        <ModulePath>.*Tiie\.Web\.dll$</ModulePath>
        <ModulePath>.*Tiie\.Migracion\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <!-- Código generado (migraciones de EF Core, generadores de fuente en obj/): no es lógica que probar. -->
    <Sources>
      <Exclude>
        <Source>.*[\\/]Migraciones[\\/].*</Source>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
