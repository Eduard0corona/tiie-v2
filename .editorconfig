root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,targets,slnx,ts,tsx,js,mjs,cjs,css,html,md,bicep}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Estilo
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

# Nombres: constantes y campos estáticos en PascalCase; campos privados de instancia con guion bajo
dotnet_naming_rule.constantes.symbols = constantes
dotnet_naming_rule.constantes.style = pascal
dotnet_naming_rule.constantes.severity = warning
dotnet_naming_symbols.constantes.applicable_kinds = field
dotnet_naming_symbols.constantes.applicable_accessibilities = *
dotnet_naming_symbols.constantes.required_modifiers = const

dotnet_naming_rule.campos_estaticos.symbols = campos_estaticos
dotnet_naming_rule.campos_estaticos.style = pascal
dotnet_naming_rule.campos_estaticos.severity = warning
dotnet_naming_symbols.campos_estaticos.applicable_kinds = field
dotnet_naming_symbols.campos_estaticos.applicable_accessibilities = private
dotnet_naming_symbols.campos_estaticos.required_modifiers = static, readonly

dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.campos_privados.symbols = campos_privados
dotnet_naming_rule.campos_privados.style = guion_bajo
dotnet_naming_rule.campos_privados.severity = warning
dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_style.guion_bajo.capitalization = camel_case
dotnet_naming_style.guion_bajo.required_prefix = _

# Analizadores
# Los mensajes y nombres están en español; las reglas de globalización no aplican así.
dotnet_diagnostic.CA1303.severity = none
# Los casos de uso y endpoints reciben dependencias por DI; no son API pública reutilizable.
dotnet_diagnostic.CA1515.severity = none
# Los registros se escriben con plantillas estructuradas; LoggerMessage se usa solo donde hay alto volumen.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# Las cadenas de formato de logs son plantillas, no texto localizable.
dotnet_diagnostic.CA2254.severity = warning

[tests/**.cs]
# Los nombres de prueba describen el comportamiento con guiones bajos: RN02_no_permite_...
dotnet_diagnostic.CA1707.severity = none
# xUnit ya ejecuta las pruebas sin contexto de sincronización.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2234.severity = none
dotnet_diagnostic.CA1062.severity = none
# Las pruebas no se cancelan a mitad; pasar TestContext.Current.CancellationToken solo agrega ruido.
dotnet_diagnostic.xUnit1051.severity = none

[src/Tiie.Infraestructura/Datos/Migraciones/**.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0161.severity = none
