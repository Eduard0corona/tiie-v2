{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tiie-web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Tiie.Web", "--launch-profile", "https", "--no-build"],
      "port": 7180,
