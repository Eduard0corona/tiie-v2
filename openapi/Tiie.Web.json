                }
              }
            }
          }
        }
      }
    },
    "/api/admin/procesos": {
      "get": {
        "tags": [
          "Administración · Auditoría"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EstadoProceso"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error como Problem Details con codigo.",
            "content": {
