    "/api/admin/catalogos": {
      "get": {
        "tags": [
          "Administración · Catálogos"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogosAdmin"
                }
              }
            }
          },
          "default": {
            "description": "Error como Problem Details con codigo.",
            "content": {
              "application/problem+json": {
