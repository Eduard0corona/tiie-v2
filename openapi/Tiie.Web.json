        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfiguracionPublica"
                }
              }
            }
          },
          "default": {
            "description": "Error como Problem Details con codigo.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemaApi"
                }
              }
            }
          }
        }
      }
    },
